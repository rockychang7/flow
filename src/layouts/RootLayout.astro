---
import BackToTop from "@/components/common/back-to-top.tsx";
import CodeCopy from "@/components/markdown/code-copy.astro";
import { SITE } from "@/constant/constants";
import "@/styles/globals.css";
// 衬线轨:拉丁 + 中文都是可变字重(wght 200–900),按 unicode-range 分片按需加载
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/noto-serif-sc";
// 等宽轨(唯一例外):代码块与日期时间戳
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
// 首屏必用的拉丁片提前拉,避免衬线正文闪一次回退字体
import sourceSerifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    ogImage?: string | null;
    noindex?: boolean;
}

const {
    title,
    description = SITE.description,
    ogImage,
    noindex = false,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href={sourceSerifLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 画布底色前置:浏览器在样式表到达前按 color-scheme 铺画布,
         深色用户冷加载不再先白后黑;下方主题脚本会把两个 meta 改成精确值 -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <style is:inline>html{background-color:#ffffff}html.dark{background-color:#0c0a09}</style>
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline data-cfasync="false">
      // 首帧前恢复主题。localStorage 是主存储,长期 Cookie 用于浏览器偶发清理
      // 单项存储后的恢复;旧的 theme 键会自动迁移到带站点命名空间的新键。
      (function () {
        const STORAGE_KEY = "flow-theme";
        const LEGACY_STORAGE_KEY = "theme";
        const COOKIE_KEY = "flow_theme";
        const COOKIE_MAX_AGE = 60 * 60 * 24 * 400;
        const MODES = ["light", "dark", "system"];
        const isMode = (value) => MODES.includes(value);

        const readLocal = (key) => {
          try {
            const value = localStorage.getItem(key);
            return isMode(value) ? value : null;
          } catch {
            return null;
          }
        };

        const readCookie = () => {
          const prefix = `${COOKIE_KEY}=`;
          const entry = document.cookie
            .split("; ")
            .find((item) => item.startsWith(prefix));
          if (!entry) return null;
          const value = decodeURIComponent(entry.slice(prefix.length));
          return isMode(value) ? value : null;
        };

        const readSavedMode = () =>
          readLocal(STORAGE_KEY) ||
          readCookie() ||
          readLocal(LEGACY_STORAGE_KEY);

        const persist = (mode) => {
          try {
            localStorage.setItem(STORAGE_KEY, mode);
            localStorage.removeItem(LEGACY_STORAGE_KEY);
          } catch {
            // Cookie fallback below still preserves the explicit choice.
          }

          const secure = location.protocol === "https:" ? "; Secure" : "";
          document.cookie =
            `${COOKIE_KEY}=${encodeURIComponent(mode)}; Path=/; ` +
            `Max-Age=${COOKIE_MAX_AGE}; SameSite=Lax${secure}`;
        };

        const apply = (mode) => {
          const resolved = isMode(mode) ? mode : "system";
          const dark =
            resolved === "dark" ||
            (resolved === "system" &&
              window.matchMedia("(prefers-color-scheme: dark)").matches);

          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.themeMode = resolved;
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute("content", dark ? "dark" : "light");
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? "#0c0a09" : "#ffffff");
        };

        window.__flowTheme = {
          getMode: () => readSavedMode() || "system",
          setMode: (mode) => {
            if (!isMode(mode)) return;
            persist(mode);
            apply(mode);
          },
          apply: () => apply(readSavedMode() || "system"),
        };

        const savedMode = readSavedMode();
        if (savedMode) persist(savedMode);
        apply(savedMode || "system");

        // ClientRouter 可能重新执行内联脚本;监听器只注册一次,执行时始终取最新控制器。
        if (window.__flowThemeListenersBound) return;
        window.__flowThemeListenersBound = true;

        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", () => {
            if (window.__flowTheme?.getMode() === "system") {
              window.__flowTheme.apply();
            }
          });

        window.addEventListener("storage", (event) => {
          if (
            event.key === null ||
            event.key === STORAGE_KEY ||
            event.key === LEGACY_STORAGE_KEY
          ) {
            window.__flowTheme?.apply();
          }
        });

        document.addEventListener("astro:before-swap", (event) => {
          const currentRoot = document.documentElement;
          const nextRoot = event.newDocument.documentElement;
          nextRoot.classList.toggle(
            "dark",
            currentRoot.classList.contains("dark")
          );
          nextRoot.dataset.themeMode =
            currentRoot.dataset.themeMode || "system";
        });

        document.addEventListener("astro:after-swap", () => {
          window.__flowTheme?.apply();
        });
      })();
    </script>

    <!-- iOS Chrome back button fix (known Astro bug workaround) -->
    <script is:inline data-cfasync="false">
      (function () {
        // Detect iOS Chrome (or any iOS browser other than Safari)
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
        const isChrome = /CriOS/.test(navigator.userAgent);
        const isIOSChrome = isIOS && isChrome;

        if (isIOSChrome) {
          // Override click handler to use history.pushState with proper state
          document.addEventListener("click", (e) => {
            const link = e.target.closest("a");
            if (!link) return;

            const href = link.getAttribute("href");
            if (!href) return;

            // Only handle internal links
            const url = new URL(href, window.location.origin);
            if (url.origin !== window.location.origin) return;
            if (link.target === "_blank") return;

            // Let Astro's router handle it, but ensure pushState is used
            // by adding data attribute
            link.setAttribute("data-astro-history", "push");
          });

          // Fix for popstate not firing on iOS Chrome
          let lastUrl = location.href;
          const observer = new MutationObserver(() => {
            if (location.href !== lastUrl) {
              lastUrl = location.href;
              window.dispatchEvent(
                new PopStateEvent("popstate", { state: history.state })
              );
            }
          });
          observer.observe(document, { subtree: true, childList: true });
        }
      })();
    </script>
    <ClientRouter />
  </head><body>
    <!-- 版心 576(每行 36 汉字),页面上下 128(移动 64);顶栏定高 48 浮在其上 -->
    <main
      class="min-h-svh mx-auto flex w-full max-w-column flex-col px-4 pt-16 pb-16 md:pt-32 md:pb-32"
    >
      <slot />
    </main>
    <CodeCopy />
    <BackToTop client:load />
    <!-- Add this portal container for dialogs -->
    <div id="dialog-portal"></div>
  </body>
</html>
