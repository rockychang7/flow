---
import BackToTop from "@/components/common/back-to-top.tsx";
import CodeCopy from "@/components/markdown/code-copy.astro";
import { SITE } from "@/constant/constants";
import "@/styles/globals.css";
// 衬线轨:拉丁 + 中文都是可变字重(wght 200–900),按 unicode-range 分片按需加载
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/noto-serif-sc";
// 等宽轨(唯一例外):代码块与日期时间戳
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
// 首屏必用的拉丁片提前拉,避免衬线正文闪一次回退字体
import sourceSerifLatin from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    ogImage?: string | null;
    noindex?: boolean;
}

const {
    title,
    description = SITE.description,
    ogImage,
    noindex = false,
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="preload"
      href={sourceSerifLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 画布底色前置:浏览器在样式表到达前按 color-scheme 铺画布,
         深色用户冷加载不再先白后黑;下方主题脚本会把两个 meta 改成精确值 -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <style is:inline>html{background-color:#ffffff}html.dark{background-color:#0c0a09}</style>
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL("rss.xml", Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline data-cfasync="false">
      // Immediately apply theme on page load
      (function () {
        // 没有保存主题时默认浅色;用户主动选择跟随系统时显式存为 system。
        // data-theme-mode 供主题钮的图标/文字纯 CSS 取态:本脚本在首帧前执行,
        // 图标不会先显示错误状态再跳到实际模式
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => {
          const stored = localStorage.getItem("theme");
          const mode =
            stored === "dark" || stored === "system" ? stored : "light";
          const dark =
            mode === "dark" || (mode === "system" && systemDark.matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.dataset.themeMode = mode;
          // 画布与手机浏览器外壳的底色跟精确主题走,样式表未就位时也生效
          document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", dark ? "dark" : "light");
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0c0a09" : "#ffffff");
        };
        apply();
        systemDark.addEventListener("change", apply);
      })();
    </script>

    <!-- View Transitions theme sync -->
    <script is:inline data-cfasync="false">
      // BEFORE swap: copy dark class and theme mode to the incoming document
      document.addEventListener("astro:before-swap", (event) => {
        const isDark = document.documentElement.classList.contains("dark");
        event.newDocument.documentElement.classList.toggle("dark", isDark);
        event.newDocument.documentElement.dataset.themeMode =
          document.documentElement.dataset.themeMode || "light";
      });

      // AFTER swap: fallback to ensure theme is correct
      // (换入的新 head 带的是静态 meta,这里恢复成精确值)
      document.addEventListener("astro:after-swap", () => {
        const stored = localStorage.getItem("theme");
        const mode =
          stored === "dark" || stored === "system" ? stored : "light";
        const dark =
          mode === "dark" ||
          (mode === "system" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.dataset.themeMode = mode;
        document.querySelector('meta[name="color-scheme"]')?.setAttribute("content", dark ? "dark" : "light");
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#0c0a09" : "#ffffff");
      });
    </script>

    <!-- iOS Chrome back button fix (known Astro bug workaround) -->
    <script is:inline data-cfasync="false">
      (function () {
        // Detect iOS Chrome (or any iOS browser other than Safari)
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
        const isChrome = /CriOS/.test(navigator.userAgent);
        const isIOSChrome = isIOS && isChrome;

        if (isIOSChrome) {
          // Override click handler to use history.pushState with proper state
          document.addEventListener("click", (e) => {
            const link = e.target.closest("a");
            if (!link) return;

            const href = link.getAttribute("href");
            if (!href) return;

            // Only handle internal links
            const url = new URL(href, window.location.origin);
            if (url.origin !== window.location.origin) return;
            if (link.target === "_blank") return;

            // Let Astro's router handle it, but ensure pushState is used
            // by adding data attribute
            link.setAttribute("data-astro-history", "push");
          });

          // Fix for popstate not firing on iOS Chrome
          let lastUrl = location.href;
          const observer = new MutationObserver(() => {
            if (location.href !== lastUrl) {
              lastUrl = location.href;
              window.dispatchEvent(
                new PopStateEvent("popstate", { state: history.state })
              );
            }
          });
          observer.observe(document, { subtree: true, childList: true });
        }
      })();
    </script>
    <ClientRouter />
  </head><body>
    <!-- 版心 576(每行 36 汉字),页面上下 128(移动 64);顶栏定高 48 浮在其上 -->
    <main
      class="min-h-svh mx-auto flex w-full max-w-column flex-col px-4 pt-16 pb-16 md:pt-32 md:pb-32"
    >
      <slot />
    </main>
    <CodeCopy />
    <BackToTop client:load />
    <!-- Add this portal container for dialogs -->
    <div id="dialog-portal"></div>
  </body>
</html>
