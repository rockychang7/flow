---
import { DATE_FORMAT } from "@/constant/constants";
import dayjs from "dayjs";

interface Props {
    title: string;
    publishDate: Date;
    coverImage?: string | null;
    wordCount?: number;
    readingTime?: number;
}

const { title, publishDate, coverImage, wordCount, readingTime } = Astro.props;
---

<!-- 文题 24/700,分量来自上方留白而非字号;meta 一行 14 muted,等宽日期;之后留 48 进正文 -->
<header class="mb-12">
    <h1 class="text-2xl font-bold text-balance text-foreground">
        {title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        <span class="inline-flex items-center gap-1.5">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            <time class="font-mono">{dayjs(publishDate).format(DATE_FORMAT)}</time>
        </span>
        {wordCount ? (
            <span class="inline-flex items-center gap-1.5">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                <span>{wordCount} 字</span>
            </span>
        ) : null}
        {readingTime ? (
            <span class="inline-flex items-center gap-1.5">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>约 {readingTime} 分钟</span>
            </span>
        ) : null}
    </div>

    {coverImage && (
        <div id="article-cover" class="break-column mt-6 overflow-hidden rounded-md border border-border">
            <img
                src={coverImage}
                alt={`${title} 封面图`}
                class="block h-full w-full object-cover object-center"
            />
        </div>
    )}
</header>
