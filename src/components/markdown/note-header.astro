---
import { DATE_FORMAT } from "@/constant/constants";
import dayjs from "dayjs";

interface Props {
    title: string;
    updated: Date;
    /** 所属专题;散篇传 null,面包屑退回「笔记」列表 */
    topicName?: string | null;
    topicUrl?: string | null;
    /** 笔记来源(原文链接),没有则不展示 */
    sourceUrl?: string | null;
    wordCount?: number;
    readingTime?: number;
}

const { title, updated, topicName, topicUrl, sourceUrl, wordCount, readingTime } = Astro.props;
---

<!-- 与文章头同构,差异两处:标题上方一行所属专题;meta 以「更新于」为主,尾部可选「原文」外链 -->
<header class="mb-12">
    <div class="mb-2 text-sm">
        <a
            href={topicUrl ?? "/notes"}
            class="text-muted-foreground transition-colors hover:text-foreground"
        >
            {topicName ?? "笔记"}
        </a>
    </div>

    <h1 class="text-2xl font-bold text-balance text-foreground">
        {title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        <span class="inline-flex items-center gap-1.5">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            <span>更新于 <time class="font-mono">{dayjs(updated).format(DATE_FORMAT)}</time></span>
        </span>
        {wordCount ? (
            <span class="inline-flex items-center gap-1.5">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
                <span>{wordCount} 字</span>
            </span>
        ) : null}
        {readingTime ? (
            <span class="inline-flex items-center gap-1.5">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>约 {readingTime} 分钟</span>
            </span>
        ) : null}
        {sourceUrl ? (
            <a
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ext-arrow text-muted-foreground transition-colors hover:text-foreground"
            >原文</a>
        ) : null}
    </div>
</header>
