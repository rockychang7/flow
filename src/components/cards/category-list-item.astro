---
interface Props {
    name: string;
    count: number;
    url: string;
}

const {name, count, url} = Astro.props;
---

<a href={url} class="group flex items-baseline justify-between gap-4 py-2">
    <span class="min-w-0 break-words font-medium transition-colors group-hover:text-muted-foreground">{name}</span>
    <span class="shrink-0 font-mono text-sm text-muted-foreground">{count}</span>
</a>
