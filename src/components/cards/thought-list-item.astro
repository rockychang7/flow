---
import ThoughtReactions from "@/components/common/thought-reactions.astro";

interface Props {
    id: number;
    html: string;
    createdAt: string;
    /** 逐批展开的钩子("reveal-item hidden"),不需要就不传 */
    class?: string;
}

const { id, html, createdAt, class: className } = Astro.props;

// created_at 是无时区的本地时间串。服务端只渲染绝对时间(年-月-日 时:分,即前 16 位),
// 一周内的条目由客户端脚本改写成相对时间 —— 相对时间若在构建时算,
// 会永远停在构建那一刻。悬停 title 始终给完整时间。
const absolute = createdAt.slice(0, 16);
---

<!-- 推文式条目:左侧圆形头像,右侧 名字 · @账号 · 时间 一行,正文在下,底部表情栏。
     无卡片无边框;条目间细线用 border-top(首条除外)而不是外层 divide-y ——
     逐批展开时末尾有隐藏条目,divide-y 会让最后一条可见条目多出一条底线。
     用 flex 而非 grid:load-more 的 noscript 兜底会把 .reveal-item 强制成 flex。 -->
<article
    class:list={[
        "thought-item flex gap-x-3 border-t border-border py-5 first:border-t-0 first:pt-0 last:pb-0",
        className,
    ]}
>
    <div
        class="grid size-10 shrink-0 place-items-center rounded-full border border-border bg-muted text-[17px] font-semibold leading-none text-foreground select-none"
        aria-hidden="true"
    >R</div>

    <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-baseline gap-x-1.5 text-sm">
            <span class="font-semibold text-foreground">Rocky</span>
            <span class="text-muted-foreground">@rocky</span>
            <span class="text-muted-foreground" aria-hidden="true">·</span>
            <time
                class="font-mono text-caption font-medium text-muted-foreground"
                datetime={createdAt.replace(" ", "T")}
                title={absolute}
                data-thought-time={createdAt}
            >{absolute}</time>
        </div>

        <div class="thought-body mt-1">
            <div class="prose max-w-none" set:html={html} />
        </div>

        <ThoughtReactions thoughtId={id} />
    </div>
</article>

<script>
    const WEEK_MS = 7 * 24 * 60 * 60 * 1000;

    // "2026-08-04 17:24:14" 不是 ISO 格式,各浏览器解析口径不一,手动拆成本地时间
    function parseLocal(value: string): Date | null {
        const m = value.match(/^(\d{4})-(\d{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2})$/);
        if (!m) return null;
        return new Date(+m[1], +m[2] - 1, +m[3], +m[4], +m[5], +m[6]);
    }

    function relative(diffMs: number): string {
        const minutes = Math.floor(diffMs / 60000);
        if (minutes < 1) return "刚刚";
        if (minutes < 60) return `${minutes} 分钟前`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours} 小时前`;
        return `${Math.floor(hours / 24)} 天前`;
    }

    function render() {
        const now = Date.now();
        document.querySelectorAll<HTMLTimeElement>("time[data-thought-time]").forEach((el) => {
            const date = parseLocal(el.dataset.thoughtTime ?? "");
            if (!date) return;
            const diff = now - date.getTime();
            // 一周内换相对时间;更早的保留服务端渲染的日期
            if (diff >= 0 && diff < WEEK_MS) el.textContent = relative(diff);
        });
    }

    render();
    document.addEventListener("astro:page-load", render);
</script>
