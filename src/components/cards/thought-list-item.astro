---
interface Props {
    html: string;
    createdAt: string;
}

const { html, createdAt } = Astro.props;
---

<!-- 想法:正文宋体 16/1.75 + 等宽 13 时间戳,无卡片无线,条目之间只有留白 -->
<article class="thought-body">
    <div class="prose max-w-none" set:html={html} />
    <time class="mt-2 block font-mono text-caption font-medium text-muted-foreground">
        {createdAt.slice(0, 16)}
    </time>
</article>

<style is:global>
    @reference "../../styles/globals.css";

    /* 想法是短文,段距收到 8;其余排版规则与长文共用 .prose 那一套 */
    .thought-body .prose p {
        @apply my-2;
    }

    .thought-body .prose > :first-child {
        margin-top: 0;
    }

    .thought-body .prose > :last-child {
        margin-bottom: 0;
    }
</style>
