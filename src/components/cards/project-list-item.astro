---
interface Props {
    title: string;
    description: string;
    url: string;
}

const {title, description, url} = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer"
   class="group flex flex-col items-start gap-1 py-2 sm:flex-row sm:items-baseline sm:gap-4">
    <span class="ext-arrow shrink-0 font-medium transition-colors group-hover:text-muted-foreground">{title}</span>
    <span class="min-w-0 break-words text-sm text-muted-foreground">{description}</span>
</a>
