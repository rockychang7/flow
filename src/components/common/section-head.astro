---
// 两种角色共用一个组件:
// as="h1" → 页题,24/700,全站唯一最大字号;as="h2" → 区块小标,14/500 muted。
// 两者下方一律留 24;页题另在上方再压一段留白(见下)。
interface Props {
    title: string;
    moreHref?: string;
    moreLabel?: string;
    /** 页面级标题用 h1(列表页),首页区块用 h2 */
    as?: "h1" | "h2";
    /** 页题下的一行板块简介(14 muted),列表页统一用它说明板块是干嘛的 */
    intro?: string;
}

const { title, moreHref, moreLabel = "查看全部", as: Tag = "h2", intro } = Astro.props;
const isPageTitle = Tag === "h1";
---
<!-- 页题上方再压 32/64,叠在布局的 64/128 上,合计 96/192;
     比关于页的 136/272 收着 —— 列表页是来找东西的,不该先滚一段空白 -->
<div
    class:list={[
        "mb-6 flex items-baseline justify-between gap-4",
        isPageTitle && "mt-8 md:mt-16",
    ]}
>
    <Tag
        class:list={[
            isPageTitle
                ? "text-2xl font-bold text-foreground"
                : "text-sm font-medium text-muted-foreground",
        ]}
    >
        {title}
    </Tag>
    {moreHref ? (
        <a
            href={moreHref}
            class="shrink-0 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            {moreLabel}
        </a>
    ) : (
        <slot name="aside" />
    )}
</div>
{intro && <p class="text-sm text-muted-foreground">{intro}</p>}
