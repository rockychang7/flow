---
// 两种角色共用一个组件:
// as="h1" → 页题,24/700,全站唯一最大字号;as="h2" → 区块小标,14/500 muted。
// 两者下方一律留 24。
interface Props {
    title: string;
    moreHref?: string;
    moreLabel?: string;
    /** 页面级标题用 h1(列表页),首页区块用 h2 */
    as?: "h1" | "h2";
}

const { title, moreHref, moreLabel = "查看全部", as: Tag = "h2" } = Astro.props;
const isPageTitle = Tag === "h1";
---
<div class="mb-6 flex items-baseline justify-between gap-4">
    <Tag
        class:list={[
            isPageTitle
                ? "text-2xl font-bold text-foreground"
                : "text-sm font-medium text-muted-foreground",
        ]}
    >
        {title}
    </Tag>
    {moreHref ? (
        <a
            href={moreHref}
            class="shrink-0 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >
            {moreLabel}
        </a>
    ) : (
        <slot name="aside" />
    )}
</div>
