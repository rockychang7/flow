---
import ArticleListItem from "@/components/cards/article-list-item.astro";
import LoadMore from "@/components/common/load-more.astro";
import SectionHead from "@/components/common/section-head.astro";
import { getPublishedArticles, sortByDateDesc } from "@/lib/articles";
import Footer from "../components/common/footer.astro";
import Header from "../components/common/header.astro";
import RootLayout from "../layouts/RootLayout.astro";

const sortBlogPosts = sortByDateDesc(await getPublishedArticles());

// 按年分组(已按时间倒序,分组后年份自然倒序)
const postsByYear = new Map<number, typeof sortBlogPosts>();
for (const post of sortBlogPosts) {
    const year = post.data.publish_date.getFullYear();
    if (!postsByYear.has(year)) postsByYear.set(year, []);
    postsByYear.get(year)!.push(post);
}

// 一条文章只占一行,比更新日志轻得多,首屏放 10 条。
// 年份只是视觉分节,展开按文章总序推进;整年都在首屏之外时连年份头一起藏。
const INITIAL = 10;
let cursor = 0;
const groups = [...postsByYear.entries()].map(([year, posts]) => {
    const items = posts.map((post) => ({ post, index: cursor++ }));
    return { year, items, hidden: items.every((item) => item.index >= INITIAL) };
});
const hasMore = sortBlogPosts.length > INITIAL;

const title: string = "文章";
---
<RootLayout title={title} description="个人沉淀,成文的思考与记录">
    <Header/>
    <div class="flex flex-col">
        <SectionHead title="文章" as="h1" intro="个人沉淀,成文的思考与记录。">
            <span slot="aside" class="flex shrink-0 items-baseline gap-x-4">
                <a href="/category" class="text-sm text-muted-foreground transition-colors hover:text-foreground">分类</a>
                <a href="/tag" class="text-sm text-muted-foreground transition-colors hover:text-foreground">标签</a>
            </span>
        </SectionHead>
        <!-- 分组间 48;年份组头 16/500 muted -->
        <div class="mt-12 flex flex-col gap-y-12">
            {groups.map((group) => (
                <section class:list={["reveal-group", group.hidden && "hidden"]}>
                    <h2 class="mb-6 font-medium text-muted-foreground">{group.year}</h2>
                    <div class="flex flex-col">
                        {group.items.map(({ post, index }) => (
                            <ArticleListItem
                                title={post.data.title}
                                date={post.data.publish_date}
                                url={`/articles/${post.id}`}
                                class={index >= INITIAL ? "reveal-item hidden" : undefined}
                            />
                        ))}
                    </div>
                </section>
            ))}
        </div>

        {hasMore && <LoadMore step={10} />}
    </div>

    <Footer/>
</RootLayout>
