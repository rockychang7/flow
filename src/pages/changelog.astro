---
import SectionHead from "@/components/common/section-head.astro";
import Footer from "@/components/common/footer.astro";
import Header from "@/components/common/header.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { changelogs } from "@/data/changelog-info";

const title = "Changelog";
---

<RootLayout title={title}>
    <Header/>

    <div class="flex flex-col">
        <SectionHead title="Changelog" as="h1" />
        <!-- 条目走全站行语法:等宽日期 + 文字;大版本靠字重与墨色区分,不用徽章与时间线 -->
        <div class="flex flex-col gap-y-12">
            {changelogs.map((log) => (
                <section class="flex flex-col gap-y-2 sm:flex-row sm:gap-x-4 sm:gap-y-0">
                    <time class="shrink-0 font-mono text-sm text-muted-foreground sm:w-24">{log.date}</time>
                    <div class="flex min-w-0 flex-col gap-y-2">
                        <div class="flex flex-wrap items-baseline gap-x-4">
                            <span
                                class:list={[
                                    "min-w-0 break-words font-medium",
                                    log.isMajor ? "text-foreground" : "text-muted-foreground",
                                ]}
                            >
                                {log.description}
                            </span>
                            <span class="font-mono text-caption font-medium text-muted-foreground">{log.version}</span>
                        </div>
                        <ul class="flex flex-col gap-y-2">
                            {log.features.map((feature) => (
                                <li class="text-sm text-body">{feature}</li>
                            ))}
                        </ul>
                    </div>
                </section>
            ))}
        </div>
    </div>

    <Footer/>
</RootLayout>
