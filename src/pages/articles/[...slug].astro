---
import Footer from "@/components/common/footer.astro";
import Header from "@/components/common/header.astro";
import ContentImageLightbox from "@/components/common/content-image-lightbox";
import ArticleHeader from "@/components/markdown/article-header.astro";
import Prose from "@/components/markdown/md-prose.astro";
import { TableOfContents } from "@/components/markdown/table-of-contents";
import { TocMobile } from "@/components/markdown/toc-mobile";
import RootLayout from "@/layouts/RootLayout.astro";
import { getReadingTime, getWordCount } from "@/lib/utils";
import { getCollection, render } from "astro:content";


export async function getStaticPaths() {
    // 开发模式下保留草稿预览,生产构建不生成草稿页面
    const blogEntries = await getCollection(
        "articles",
        ({data}) => import.meta.env.DEV || data.draft !== true
    );
    return blogEntries.map(entry => ({
        params: {slug: entry.id},
        props: {entry}
    }));
}

const {entry} = Astro.props;
const {Content, headings} = await render(entry);
const body = entry.body ?? "";
const wordCount = getWordCount(body);
const readingTime = getReadingTime(body);
const tags = entry.data.tags;
const imageGroups = entry.data.cover_url
    ? ["#article-cover", "#article-content"]
    : ["#article-content"];

---
<RootLayout
    title={entry.data.title}
    description={entry.data.description}
    ogImage={entry.data.cover_url}
>
    <Header/>

    <div class="relative">
        <ArticleHeader
            title={entry.data.title}
            publishDate={entry.data.publish_date}
            coverImage={entry.data.cover_url}
            wordCount={wordCount}
            readingTime={readingTime}
        />
        <div id="article-content">
            <Prose>
                <Content/>
            </Prose>
        </div>
        <ContentImageLightbox client:load groupSelectors={imageGroups} />

        {tags.length > 0 && (
            <div class="mt-12 flex flex-wrap gap-x-4 gap-y-2 text-sm">
                {tags.map(tag => (
                    <a
                        href={`/tags/${tag}`}
                        class="text-muted-foreground transition-colors hover:text-foreground"
                    >
                        #{tag}
                    </a>
                ))}
            </div>
        )}

        <aside class="absolute left-full top-0 ml-16 hidden h-full w-48 xl:block">
             <div class="sticky top-16">
                 <TableOfContents client:load headings={headings} hideTitle />
             </div>
        </aside>
    </div>

    <TocMobile client:load headings={headings} />
    <Footer/>
</RootLayout>
