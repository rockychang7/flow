---
import ArticleListItem from "@/components/cards/article-list-item.astro";
import ContentImageLightbox from "@/components/common/content-image-lightbox";
import LoadMore from "@/components/common/load-more.astro";
import Footer from "@/components/common/footer.astro";
import Header from "@/components/common/header.astro";
import SectionHead from "@/components/common/section-head.astro";
import NoteHeader from "@/components/markdown/note-header.astro";
import Prose from "@/components/markdown/md-prose.astro";
import { TableOfContents } from "@/components/markdown/table-of-contents";
import { TocMobile } from "@/components/markdown/toc-mobile";
import RootLayout from "@/layouts/RootLayout.astro";
import { getTopic, getVisibleNotes, groupNotes, noteTopics, sortByCreatedAsc, type Note, type NoteTopic } from "@/lib/notes";
import { getReadingTime, getWordCount } from "@/lib/utils";
import { render } from "astro:content";

// 专题页与笔记详情页共用 /notes/ 下的一段路径:
// slug 全局唯一(同步脚本校验笔记 slug 不与专题 slug 冲突),按 props.type 分流渲染
export async function getStaticPaths() {
    const notes = await getVisibleNotes();
    const { groups } = groupNotes(notes);

    // 路由层兜底:同步脚本的 slug 校验管不到手写文件,这里再断言一次全集不冲突
    const topicSlugSet = new Set(noteTopics.map((t) => t.slug));
    for (const note of notes) {
        if (topicSlugSet.has(note.id)) {
            throw new Error(`笔记 slug "${note.id}" 与专题 slug 冲突,两者共用 /notes/ 路径段,请改名`);
        }
    }

    const topicPaths = groups.map((group) => ({
        params: { slug: group.topic.slug },
        props: { type: "topic" as const, topic: group.topic, notes: group.notes },
    }));

    const notePaths = notes.map((entry) => {
        // 专题内上/下一篇按学习顺序(创建日期升序);散篇没有前后件
        const siblings = entry.data.topic
            ? sortByCreatedAsc(notes.filter((n) => n.data.topic === entry.data.topic))
            : [];
        const index = siblings.findIndex((n) => n.id === entry.id);
        return {
            params: { slug: entry.id },
            props: {
                type: "note" as const,
                entry,
                prev: index > 0 ? siblings[index - 1] : null,
                next: index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null,
            },
        };
    });

    return [...topicPaths, ...notePaths];
}

type Props =
    | { type: "topic"; topic: NoteTopic; notes: Note[] }
    | { type: "note"; entry: Note; prev: Note | null; next: Note | null };

const props = Astro.props as Props;

let noteView = null;
if (props.type === "note") {
    const { entry } = props;
    const { Content, headings } = await render(entry);
    const body = entry.body ?? "";
    const topic = entry.data.topic ? getTopic(entry.data.topic) : undefined;
    noteView = {
        Content,
        headings,
        wordCount: getWordCount(body),
        readingTime: getReadingTime(body),
        topic,
    };
}

const pageTitle = props.type === "topic" ? props.topic.name : props.entry.data.title;
const pageDescription =
    props.type === "topic" ? props.topic.description : `${props.entry.data.title} - 学习笔记`;
---
<RootLayout title={pageTitle} description={pageDescription}>
    <Header/>

    {props.type === "topic" && (
        <div class="flex flex-col">
            <SectionHead title={props.topic.name} as="h1">
                <a
                    slot="aside"
                    href="/notes"
                    class="shrink-0 text-sm text-muted-foreground transition-colors hover:text-foreground"
                >全部笔记</a>
            </SectionHead>
            <p class="text-sm text-muted-foreground">
                {props.topic.description}共 <span class="font-mono">{props.notes.length}</span> 篇。
            </p>

            <div class="mt-12 flex flex-col">
                {props.notes.map((note, index) => (
                    <ArticleListItem
                        title={note.data.title}
                        date={note.data.created}
                        url={`/notes/${note.id}`}
                        class={index >= 10 ? "reveal-item hidden" : undefined}
                    />
                ))}
            </div>

            {props.notes.length > 10 && <LoadMore step={10} />}
        </div>
    )}

    {props.type === "note" && noteView && (
        <div class="relative">
            <NoteHeader
                title={props.entry.data.title}
                updated={props.entry.data.updated}
                topicName={noteView.topic?.name ?? null}
                topicUrl={noteView.topic ? `/notes/${noteView.topic.slug}` : null}
                sourceUrl={props.entry.data.source_url}
                wordCount={noteView.wordCount}
                readingTime={noteView.readingTime}
            />
            <div id="note-content">
                <Prose>
                    <noteView.Content/>
                </Prose>
            </div>
            <ContentImageLightbox client:load groupSelectors={["#note-content"]} />

            {(props.prev || props.next) && (
                <nav class="mt-12 flex items-start justify-between gap-4">
                    {props.prev ? (
                        <a href={`/notes/${props.prev.id}`} class="group min-w-0">
                            <span class="block text-caption font-medium text-muted-foreground">上一篇</span>
                            <span class="mt-1 block break-words text-sm font-medium transition-colors group-hover:text-muted-foreground">
                                {props.prev.data.title}
                            </span>
                        </a>
                    ) : <span></span>}
                    {props.next ? (
                        <a href={`/notes/${props.next.id}`} class="group min-w-0 text-right">
                            <span class="block text-caption font-medium text-muted-foreground">下一篇</span>
                            <span class="mt-1 block break-words text-sm font-medium transition-colors group-hover:text-muted-foreground">
                                {props.next.data.title}
                            </span>
                        </a>
                    ) : <span></span>}
                </nav>
            )}

            <aside class="absolute left-full top-0 ml-16 hidden h-full w-48 xl:block">
                <div class="sticky top-16">
                    <TableOfContents client:load headings={noteView.headings} hideTitle />
                </div>
            </aside>
        </div>
    )}

    {props.type === "note" && noteView && (
        <TocMobile client:load headings={noteView.headings} />
    )}

    <Footer/>
</RootLayout>
